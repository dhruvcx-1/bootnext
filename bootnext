#!/bin/bash

RED=$(printf '\033[0;31m')
GREEN=$(printf '\033[0;32m')
YELLOW=$(printf '\033[1;33m')
BLUE=$(printf '\033[0;34m')
CYAN=$(printf '\033[0;36m')
BOLD=$(printf '\033[1m')
DIM=$(printf '\033[2m')
NC=$(printf '\033[0m')

CONFIG_FILE="$HOME/.config/reboot-next.conf"

mkdir -p "$(dirname "$CONFIG_FILE")"

list_entries() {
    current=$(sudo efibootmgr | awk '/BootCurrent/ {print $2}')

    echo
    printf "%-8s %-8s %s\n" "CURRENT" "ID" "NAME"
    printf "%-8s %-8s %s\n" "-------" "--" "----"

    sudo efibootmgr | while IFS= read -r line; do
        if [[ $line =~ ^Boot([0-9A-F]{4})\*?[[:space:]]+(.*)$ ]]; then
            id="${BASH_REMATCH[1]}"
            desc="${BASH_REMATCH[2]}"
            desc=$(echo "$desc" | sed 's/\t.*//')

            marker=""
            [[ "$id" == "$current" ]] && marker="▶"

            printf "%-8s %-8s %s\n" "$marker" "$id" "$desc"
        fi
    done

    echo
}


set_default() {
    echo "$1" > "$CONFIG_FILE"
    echo "Default boot entry set to: $1"
}

show_default() {
    if [[ -f "$CONFIG_FILE" ]]; then
        echo "Default entry: $(cat "$CONFIG_FILE")"
    else
        echo "No default entry configured."
    fi
}

boot_entry() {
    local entry="$1"

    if ! sudo efibootmgr | grep -q "^Boot${entry}\*"; then
        echo "Boot entry $entry not found."
        exit 1
    fi

    echo "Setting BootNext=$entry"
    sudo efibootmgr -n "$entry" || exit 1

    echo "Rebooting..."
    sudo reboot
}

install_self() {
    local target="/usr/local/bin/bootnext"
    local source

    source="$(realpath "$0")"

    echo "Installing bootnext..."
    sudo ln -sf "$source" "$target"

    echo
    echo "Installed:"
    echo "  $target -> $source"
    echo
    echo "You can now run:"
    echo "  bootnext --help"
}

uninstall_self() {
    local target="/usr/local/bin/bootnext"

    if [[ ! -L "$target" && ! -f "$target" ]]; then
        echo "bootnext is not installed."
        exit 1
    fi

    echo "Removing bootnext..."
    sudo rm -f "$target"

    echo
    echo "bootnext has been uninstalled."
}


show_help() {
cat << EOF

${CYAN}${BOLD}
╔══════════════════════════════════════════════════════════════╗
║                          bootnext                           ║
║              One-time UEFI BootNext Manager                 ║
╚══════════════════════════════════════════════════════════════╝
${NC}

${BOLD}Boot into any UEFI entry for the next reboot only.${NC}

${BLUE}USAGE${NC}
  bootnext [OPTION]

${BLUE}OPTIONS${NC}

  ${GREEN}--list${NC}
      Show available UEFI boot entries.

  ${GREEN}--boot <BOOT_ID>${NC}
      Reboot once into the specified boot entry.

  ${GREEN}--set-default <BOOT_ID>${NC}
      Save a default boot entry.

  ${GREEN}--show-default${NC}
      Display the configured default entry.

  ${GREEN}--default${NC}
      Reboot once into the saved default entry.

  ${GREEN}--install${NC}
      Install bootnext into /usr/local/bin.

  ${GREEN}--uninstall${NC}
      Remove bootnext from /usr/local/bin.

  ${GREEN}-h, --help${NC}
      Show this help page.

${BLUE}EXAMPLES${NC}

  ${YELLOW}# Show available boot entries${NC}
  bootnext --list

  ${YELLOW}# Save Windows as the default target${NC}
  bootnext --set-default 0000

  ${YELLOW}# Save Fedora as the default target${NC}
  bootnext --set-default 0007

  ${YELLOW}# Reboot into the saved target${NC}
  bootnext --default

  ${YELLOW}# Reboot into Windows once${NC}
  bootnext --boot 0000

  ${YELLOW}# Reboot into Fedora once${NC}
  bootnext --boot 0007

  ${YELLOW}# Install bootnext system-wide${NC}
  ./bootnext --install

${BLUE}NOTES${NC}

  ${DIM}• Uses UEFI BootNext via efibootmgr
  • Does not modify permanent boot order
  • Selected entry is used for the next boot only
  • Firmware automatically returns to normal boot order
  • Requires sudo privileges to modify UEFI variables${NC}

${BLUE}PROJECT${NC}

  GitHub: https://github.com/dhruvcx-1/bootnext

EOF
}

case "$1" in
    --list)
        list_entries
        ;;

    --set-default)
        if [[ -z "$2" ]]; then
            echo
            echo "Error: Missing boot entry ID."
            echo
            echo "Usage:"
            echo "  $0 --set-default <BOOT_ID>"
            echo
            echo "Example:"
            echo "  $0 --set-default 0000"
            echo
            exit 1
        fi

        set_default "$2"
        ;;

    --show-default)
        show_default
        ;;

    --default)
        if [[ ! -f "$CONFIG_FILE" ]]; then
            echo
            echo "Error: No default boot entry configured."
            echo
            echo "Set one first with:"
            echo "  $0 --set-default <BOOT_ID>"
            echo
            exit 1
        fi

        boot_entry "$(cat "$CONFIG_FILE")"
        ;;

    --boot)
        if [[ -z "$2" ]]; then
            echo
            echo "Error: Missing boot entry ID."
            echo
            echo "Usage:"
            echo "  $0 --boot <BOOT_ID>"
            echo
            echo "Example:"
            echo "  $0 --boot 0007"
            echo
            exit 1
        fi

        boot_entry "$2"
        ;;

    -h|--help|"")
        show_help
        ;;
        
    --install)
        install_self
        ;;

    --uninstall)
        uninstall_self
        ;;

    *)
        echo
        echo "Error: Unknown option '$1'"
        echo
        echo "Run '$0 --help' for usage information."
        echo
        exit 1
        ;;
esac
